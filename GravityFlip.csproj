<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ce projet se compile SANS avoir le jeu installé :
      - BepInEx et Harmony viennent de NuGet (nuget.bepinex.dev) ;
      - Unity vient du paquet NuGet UnityEngine.Modules ;
      - les classes d'ULTRAKILL viennent de coquilles vides (dossier stubs/).
    C'est ce qui permet à GitHub Actions de produire GravityFlip.dll automatiquement.
  -->

  <PropertyGroup>
    <!-- ULTRAKILL tourne sur Unity (Mono) : on compile pour .NET Framework 4.7.2 -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>GravityFlip</AssemblyName>
    <RootNamespace>GravityFlip</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.2.0</Version>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>

    <!-- Facultatif : si ce dossier existe, la DLL y est copiée après compilation -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\ULTRAKILL</GamePath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="stubs/**" />
    <None Remove="stubs/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Coquilles vides des classes du jeu : jamais copiées à côté du mod -->
    <ProjectReference Include="stubs/Assembly-CSharp.csproj" Private="false" />
  </ItemGroup>

  <Target Name="CopyToPlugins" AfterTargets="Build" Condition="Exists('$(GamePath)\BepInEx\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\BepInEx\plugins\GravityFlip" />
    <Message Importance="high" Text="GravityFlip copié dans $(GamePath)\BepInEx\plugins\GravityFlip" />
  </Target>

</Project>
